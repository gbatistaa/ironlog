### ==================== READ ====================

### Buscar todos os exercícios
GET {{baseUrl}}/exercise

### Buscar exercício por ID (substituir pelo ID real)
@exerciseId = e4526b14-ce54-4526-96f3-ce13719dec6b
GET {{baseUrl}}/exercise/{{exerciseId}}

### ==================== UPDATE ====================

### Atualizar exercício - mudar nome e descrição
PATCH {{baseUrl}}/exercise/{{exerciseId}}
Content-Type: application/json

{
  "name": "Supino Reto com Barra",
  "description": "Exercício composto para peitoral maior com barra olímpica"
}

### Atualizar exercício - adicionar videoUrl
PATCH {{baseUrl}}/exercise/{{exerciseId}}
Content-Type: application/json

{
  "videoUrl": "https://www.youtube.com/watch?v=novo-video"
}

### ==================== DELETE ====================

### Deletar exercício por ID
DELETE {{baseUrl}}/exercise/{{exerciseId}}


###############################################################################
# WORKOUT
###############################################################################

### ==================== CREATE ====================

### Criar treino - Treino A (Peito e Tríceps)
POST {{baseUrl}}/workout
Content-Type: application/json

{
  "name": "Treino A - Peito e Tríceps",
  "description": "Treino focado em peito e tríceps"
}

### Criar treino - Treino B (Costas e Bíceps)
POST {{baseUrl}}/workout
Content-Type: application/json

{
  "name": "Treino B - Costas e Bíceps",
  "description": "Treino focado em costas e bíceps"
}

### Criar treino - Treino C (Pernas)
POST {{baseUrl}}/workout
Content-Type: application/json

{
  "name": "Treino C - Pernas",
  "description": "Treino focado em pernas completo"
}

### Criar treino - Treino D (Ombros e Abdômen)
POST {{baseUrl}}/workout
Content-Type: application/json

{
  "name": "Treino D - Ombros e Abdômen",
  "description": "Treino focado em ombros e abdômen"
}

### Criar treino - Treino Full Body
POST {{baseUrl}}/workout
Content-Type: application/json

{
  "name": "Treino Full Body",
  "description": "Treino completo de corpo inteiro"
}

### Criar treino - Treino Cardio
POST {{baseUrl}}/workout
Content-Type: application/json

{
  "name": "Treino Cardio"
}

### ==================== READ ====================

### Buscar todos os treinos
GET {{baseUrl}}/workout

### Buscar treino por ID (substituir pelo ID real)
@workoutId = b3c7b96c-318f-431c-8928-e4f3c83fda5e
GET {{baseUrl}}/workout/{{workoutId}}

### ==================== UPDATE ====================

### Atualizar treino - mudar nome
PATCH {{baseUrl}}/workout/{{workoutId}}
Content-Type: application/json

{
  "name": "Treino A - Peito, Ombros e Tríceps"
}

### Atualizar treino - mudar descrição
PATCH {{baseUrl}}/workout/{{workoutId}}
Content-Type: application/json

{
  "description": "Treino push focado em peito, ombros e tríceps"
}

### ==================== DELETE ====================

### Deletar treino por ID
DELETE {{baseUrl}}/workout/{{workoutId}}


###############################################################################
# WORKOUT-EXERCISE (Relação Treino <-> Exercício)
###############################################################################

### ==================== CREATE ====================

### Criar relação - Supino Reto no Treino A (pesado)
@workoutIdForLink = b3c7b96c-318f-431c-8928-e4f3c83fda5e
@exerciseIdForLink = ee899ff3-251c-4f7a-8bf0-bf642d02de99
POST {{baseUrl}}/workout-exercise
Content-Type: application/json

{
  "workoutId": "{{workoutIdForLink}}",
  "exerciseId": "{{exerciseIdForLink}}",
  "sets": 4,
  "reps": 8,
  "weight": 80.0,
  "restTime": 120
}

### Criar relação - Supino Inclinado no Treino A
POST {{baseUrl}}/workout-exercise
Content-Type: application/json

