@baseUrl = http://localhost:4000/api

###############################################################################
# EXERCISE
###############################################################################

### ==================== CREATE ====================

### Criar exercício - Supino Reto
POST {{baseUrl}}/exercise
Content-Type: application/json

{
  "name": "Supino Reto",
  "description": "Exercício composto para peito com barra",
  "muscleGroup": 0,
  "videoUrl": "https://www.youtube.com/watch?v=supino-reto"
}

